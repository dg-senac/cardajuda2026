# Copie este arquivo para .env.local (que NÃO vai para o git) e preencha.
#
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler".
# Copie a string inteira e troque apenas [YOUR-PASSWORD] pela senha do banco.
#
# O host direto (db.<ref>.supabase.co) é somente IPv6 e falha em muitas redes;
# o pooler abaixo tem IPv4. O usuário do pooler inclui o ref do projeto.
DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha>@aws-0-<região>.pooler.supabase.com:5432/postgres?sslmode=require

# Depois de salvar, confirme a conexão e crie as tabelas:
#   npm run db:check     # diagnóstico completo (host, DNS, tabelas, query do cadastro)
#   npm run db:setup     # aplica supabase/schema.sql
#   npm run db:seed      # opcional: contas de demonstração (senha 123456)
#
# Opcionais:
# DB_DEBUG_ERRORS=1              # mostra o detalhe técnico dos erros de banco na tela também em produção
# DB_CONNECTION_TIMEOUT_MS=15000 # tempo máximo para obter conexão do pool (padrão 15000)
